{
  "name": "availability",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "hono": "^4.13.21"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "4.124.0"
  }
}
